{
  "name": "@provablehq/veil-leo",
  "version": "0.12.1",
  "description": "TypeScript wrapper for the Leo CLI to build, deploy, run, and test Aleo programs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProvableHQ/veil.git",
    "directory": "packages/leo"
  },
  "homepage": "https://github.com/ProvableHQ/veil/tree/main/packages/leo#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",

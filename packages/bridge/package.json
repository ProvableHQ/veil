{
  "name": "@provablehq/aleo-bridge-sdk",
  "version": "0.12.1",
  "description": "Protocol bridge client for Circle xReserve and Hyperlane routes connected to Aleo.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProvableHQ/veil.git",
    "directory": "packages/bridge"
  },
  "homepage": "https://github.com/ProvableHQ/veil#readme",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./agent": {
      "import": "./dist/agent/index.js",
      "types": "./dist/agent/index.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp/index.js",
      "types": "./dist/mcp/index.d.ts"
    },
    "./node": {
      "import": "./dist/node.js",
      "types": "./dist/node.d.ts"
    },
    "./solana": {
      "import": "./dist/solana/index.js",
      "types": "./dist/solana/index.d.ts"
    },
    "./skills/*": "./skills/*",
    "./examples/*": "./examples/*",
    "./privy": {
      "types": "./dist/privy/index.d.ts",
      "import": "./dist/privy/index.js"
    },
    "./dynamic": {
      "types": "./dist/dynamic/index.d.ts",
      "import": "./dist/dynamic/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --root ../.. packages/bridge/test --exclude 'packages/bridge/test/integration/live/**/*.live.test.ts'",
    "test:integration": "vitest run --root ../.. packages/bridge/test/integration/lifecycle",
    "test:live": "vitest run --root ../.. packages/bridge/test/integration/live",
    "test:live:mainnet": "vitest run --root ../.. packages/bridge/test/integration/live/mainnet",
    "typecheck": "tsc --noEmit",
    "solana-deposit": "tsx scripts/solana-deposit.ts"
  },
  "files": [
    "dist",
    "examples/*.ts",
    "examples/README.md",
    "examples/tsconfig.json",
    "skills/*.md",
    "examples/remote-wallets"
  ],
  "dependencies": {
    "@provablehq/veil-core": "workspace:*",
    "bs58": "^6.0.0",
    "viem": "^2.21.0"
  },
  "peerDependencies": {
    "@provablehq/sdk": "^0.12.0",
    "@solana/kit": "^8.0.0",
    "@privy-io/node": "^0.35.0",
    "@dynamic-labs-wallet/node-evm": "^1.1.24",
    "@dynamic-labs-wallet/node-svm": "^1.1.24"
  },
  "peerDependenciesMeta": {
    "@provablehq/sdk": {
      "optional": true
    },
    "@solana/kit": {
      "optional": true
    },
    "@privy-io/node": {
      "optional": true
    },
    "@dynamic-labs-wallet/node-evm": {
      "optional": true
    },
    "@dynamic-labs-wallet/node-svm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dynamic-labs-wallet/node-evm": "1.1.24",
    "@dynamic-labs-wallet/node-svm": "1.1.24",
    "@privy-io/node": "0.35.0",
    "@provablehq/sdk": "^0.12.0",
    "@provablehq/veil-aleo-sdk": "workspace:*",
    "@solana/kit": "^8.0.0",
    "tsx": "^4.21.0"
  }
}

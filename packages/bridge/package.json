{
  "name": "@provablehq/aleo-bridge-sdk",
  "version": "0.9.0-rc.1",
  "description": "Protocol bridge client for Circle xReserve and Hyperlane routes connected to Aleo.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProvableHQ/veil.git",
    "directory": "packages/bridge"
  },
  "homepage": "https://github.com/ProvableHQ/veil#readme",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./agent": {
      "import": "./dist/agent/index.js",
      "types": "./dist/agent/index.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp/index.js",
      "types": "./dist/mcp/index.d.ts"
    },
    "./solana": {
      "import": "./dist/solana/index.js",
      "types": "./dist/solana/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "solana-deposit": "tsx scripts/solana-deposit.ts"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@provablehq/veil-core": "workspace:*",
    "bs58": "^6.0.0",
    "viem": "^2.21.0"
  },
  "peerDependencies": {
    "@provablehq/sdk": "^0.11.6",
    "@solana/kit": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@provablehq/sdk": {
      "optional": true
    },
    "@solana/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@provablehq/sdk": "^0.11.6",
    "@solana/kit": "^8.0.0",
    "tsx": "^4.21.0"
  }
}

{
  "name": "@provablehq/shield-swap-cli",
  "version": "0.16.0",
  "description": "Command line trader for the Shield Swap AMM DEX on Aleo.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProvableHQ/veil.git",
    "directory": "packages/shield-swap-cli"
  },
  "homepage": "https://github.com/ProvableHQ/veil/tree/main/packages/shield-swap-cli#readme",
  "type": "module",
  "exports": {
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    }
  },
  "bin": {
    "shield-swap": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:package": "pnpm build && node --test test/package-smoke.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@provablehq/shield-swap-sdk": "workspace:^",
    "@provablehq/veil-aleo-sdk": "workspace:^",
    "@provablehq/veil-core": "workspace:^"
  },
  "keywords": [
    "aleo",
    "veil",
    "typescript",
    "privacy",
    "cli",
    "defi",
    "dex",
    "shield-swap",
    "trading"
  ],
  "bugs": {
    "url": "https://github.com/ProvableHQ/veil/issues"
  }
}

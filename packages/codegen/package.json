{
  "name": "@provablehq/veil-codegen",
  "version": "0.12.1",
  "description": "Generate typed TypeScript contract bindings from Aleo program ABIs with the veil-codegen CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProvableHQ/veil.git",
    "directory": "packages/codegen"
  },
  "homepage": "https://github.com/ProvableHQ/veil/tree/main/packages/codegen#readme",
  "type": "module",
  "bin": {
    "veil-codegen": "./dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@provablehq/veil-core": "workspace:*"
  },
  "devDependencies": {
    "@provablehq/veil-aleo-devnode": "workspace:*",
    "@provablehq/veil-leo": "workspace:*",
    "@provablehq/veil-aleo-sdk": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "aleo",
    "veil",
    "typescript",
    "privacy",
    "codegen",
    "abi",
    "cli",
    "smart-contracts",
    "type-generation"
  ],
  "bugs": {
    "url": "https://github.com/ProvableHQ/veil/issues"
  }
}
